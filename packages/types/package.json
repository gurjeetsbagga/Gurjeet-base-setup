{
  "name": "@auryn/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript type definitions for the Auryn monorepo",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "clean": "rm -rf dist .turbo *.tsbuildinfo coverage"
  },
  "devDependencies": {
    "@auryn/config": "workspace:*",
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8"
  }
}
