{
  "name": "@auryn/utils",
  "version": "0.0.0",
  "private": true,
  "description": "Shared pure utility functions for the Auryn monorepo",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@auryn/config": "workspace:*",
    "@eslint/js": "^9",
    "@types/node": "^25.7.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8"
  }
}
