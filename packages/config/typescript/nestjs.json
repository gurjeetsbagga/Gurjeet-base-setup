{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Auryn — NestJS",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "noEmit": false,
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
