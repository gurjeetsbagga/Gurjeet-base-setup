{
  "name": "@auryn/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint, and Prettier configurations for the Auryn monorepo",
  "type": "module",
  "exports": {
    "./typescript/*": "./typescript/*",
    "./env": {
      "types": "./env/env.ts",
      "default": "./dist/env/env.js"
    },
    "./env/urls": {
      "types": "./env/urls.ts",
      "default": "./dist/env/urls.js"
    },
    "./limits": {
      "types": "./limits.ts",
      "default": "./dist/limits.js"
    }
  },
  "files": [
    "dist",
    "typescript",
    "env",
    "limits.ts"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint env/ --max-warnings 0",
    "lint:fix": "eslint env/ --fix",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8"
  }
}
