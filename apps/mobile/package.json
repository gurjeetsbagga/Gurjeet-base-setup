{
  "name": "@auryn/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Auryn mobile application — Expo + React Native",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "echo 'Use EAS Build for production builds'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "test": "echo 'Mobile tests require device/emulator — see docs/engineering/testing-strategy.md'",
    "test:ci": "echo 'Mobile CI tests not yet configured'",
    "clean": "rm -rf .expo dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@auryn/config": "workspace:*",
    "@auryn/types": "workspace:*",
    "@auryn/utils": "workspace:*",
    "expo": "~53",
    "expo-constants": "~17",
    "expo-linking": "~7",
    "expo-router": "~5",
    "expo-status-bar": "~2",
    "expo-system-ui": "~4",
    "react": "^19",
    "react-native": "~0.79",
    "react-native-safe-area-context": "~5",
    "react-native-screens": "~4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/react": "^19",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
