# ╔══════════════════════════════════════════════════════════════════╗
# ║  Auryn — Environment Variables                                  ║
# ║                                                                  ║
# ║  Copy to .env and fill in values. NEVER commit .env files.       ║
# ║                                                                  ║
# ║  Naming convention:                                              ║
# ║    SERVICE_VARIABLE_NAME   — server-side only                    ║
# ║    NEXT_PUBLIC_*           — exposed to Next.js client (web)     ║
# ║    EXPO_PUBLIC_*           — exposed to Expo client (mobile)     ║
# ║                                                                  ║
# ║  URL resolution (managed by @auryn/config/env/urls):             ║
# ║    Development — auto-derived from SERVICE_PORTS if unset.       ║
# ║    Staging/Production — MUST be set explicitly; missing          ║
# ║    values throw at startup.                                      ║
# ╚══════════════════════════════════════════════════════════════════╝

# ──────────────────────────────────────────────────────────────────
# Global
# ──────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────────────
# API  (apps/api — NestJS)
# ──────────────────────────────────────────────────────────────────
# Port/host used by the NestJS server. CORS origins are derived
# from SERVICE_PORTS in dev; set explicitly for staging/production.

API_PORT=4000
API_HOST=0.0.0.0
# API_CORS_ORIGINS=                # Comma-separated; auto-derived in dev
                                   # Production example:
                                   #   API_CORS_ORIGINS=https://auryn.app,https://admin.auryn.app

# JWT / Auth (local development — required unless Supabase is configured below)
# Set any long random string for fresh install (e.g. openssl rand -hex 32) or (pnpm key:generate)
API_JWT_SECRET=
API_JWT_EXPIRES_IN=15m
API_JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting — tiered by endpoint sensitivity
# TTL is in seconds; limit is requests per TTL window.
# Production values should be tuned per deployment.

RATE_LIMIT_GLOBAL_TTL=60              # Global: baseline for all endpoints
RATE_LIMIT_GLOBAL_LIMIT=100
RATE_LIMIT_AI_TTL=60                  # AI: completion endpoints (expensive)
RATE_LIMIT_AI_LIMIT=20
RATE_LIMIT_AUTH_TTL=60                # Auth: login/register (brute-force protection)
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_STRICT_TTL=60              # Strict: password reset, OTP (abuse prevention)
RATE_LIMIT_STRICT_LIMIT=5

# ──────────────────────────────────────────────────────────────────
# Web  (apps/web — Next.js)
# ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL is resolved automatically in development
# (http://localhost:${API_PORT}). Set explicitly in staging/prod.

WEB_PORT=3000
NEXT_PUBLIC_APP_NAME=Auryn
# NEXT_PUBLIC_APP_URL=             # Auto-derived in dev
                                   # Staging: https://staging.auryn.app
                                   # Production: https://auryn.app
# NEXT_PUBLIC_API_URL=             # Auto-derived in dev
                                   # Staging: https://api-staging.auryn.app
                                   # Production: https://api.auryn.app

# ──────────────────────────────────────────────────────────────────
# Admin  (apps/admin — Next.js)
# ──────────────────────────────────────────────────────────────────

ADMIN_PORT=3100
# NEXT_PUBLIC_ADMIN_URL=           # Auto-derived in dev
                                   # Production: https://admin.auryn.app
# NEXT_PUBLIC_API_URL=             # Shared with web; set once in root .env

# ──────────────────────────────────────────────────────────────────
# Mobile  (apps/mobile — Expo)
# ──────────────────────────────────────────────────────────────────
# EXPO_PUBLIC_API_URL is resolved automatically in development
# (http://localhost:${API_PORT}). Set explicitly for device builds.

EXPO_PUBLIC_APP_NAME=Auryn
# EXPO_PUBLIC_API_URL=             # Auto-derived in dev
                                   # Staging: https://api-staging.auryn.app
                                   # Production: https://api.auryn.app

# ──────────────────────────────────────────────────────────────────
# Database  (PostgreSQL via Prisma)
# ──────────────────────────────────────────────────────────────────
#
# Local development: point both at your local Postgres.
# Supabase: DATABASE_URL is the pooled connection (port 6543),
#           DATABASE_DIRECT_URL is the direct connection (port 5432).
#           Prisma uses directUrl for migrations, url for runtime.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auryn_dev
# DATABASE_DIRECT_URL=              # Required with Supabase (non-pooled, port 5432)
                                    # Supabase example:
                                    #   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# DATABASE_SHADOW_URL=              # Prisma shadow database for migrations

# ──────────────────────────────────────────────────────────────────
# Supabase  (auth, storage, Postgres hosting)
# ──────────────────────────────────────────────────────────────────
#
# The Supabase integration is optional. If SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are set, auth uses Supabase (not local JWT).
# For a fresh local install, leave these commented and set API_JWT_SECRET only.
# The SupabaseModule activates when URL + service role key are present.
# automatically. If unset, the module logs a warning and stays inert.
#
# Find credentials at: https://supabase.com/dashboard → Project → Settings → API

# SUPABASE_URL=                     # Project URL: https://<ref>.supabase.co
# SUPABASE_ANON_KEY=                # Public anon key (safe for client-side, respects RLS)
# SUPABASE_SERVICE_ROLE_KEY=        # ⚠️  Server-side only — NEVER expose to client
                                    # Bypasses Row Level Security; use only in apps/api
# SUPABASE_JWT_SECRET=              # ⚠️  Server-side only — JWT secret for token verification
                                    # Found in: Dashboard → Settings → API → JWT Settings

# ──────────────────────────────────────────────────────────────────
# OpenAI  ⚠️  SERVER-ONLY — NEVER prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_
# ──────────────────────────────────────────────────────────────────
#
# These secrets are loaded exclusively by apps/api (NestJS backend).
# The backend validates at startup that no NEXT_PUBLIC_OPENAI_* or
# EXPO_PUBLIC_OPENAI_* variables exist in the environment. If they
# do, the app will refuse to start in production.
#
# Frontend clients interact with AI ONLY through the backend API.
# See: docs/architecture/backend-architecture.md

# OPENAI_API_KEY=                   # ⚠️  Server-side only (apps/api) — NEVER expose
# OPENAI_ORG_ID=                    # ⚠️  Server-side only
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_MAX_TOKENS=4096
# OPENAI_TEMPERATURE=0.7
# OPENAI_TIMEOUT_MS=60000
# OPENAI_STREAM_TIMEOUT_MS=120000
# OPENAI_MAX_RETRIES=3
# OPENAI_RETRY_BASE_DELAY_MS=500

# ──────────────────────────────────────────────────────────────────
# Redis  (session store / caching — optional)
# ──────────────────────────────────────────────────────────────────

# REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────────────────────
# AWS  (S3, SES, etc. — when integrated)
# ──────────────────────────────────────────────────────────────────

# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# ──────────────────────────────────────────────────────────────────
# Railway  (deployment platform)
# ──────────────────────────────────────────────────────────────────
# These are injected automatically by Railway at deploy time.
# Listed here for documentation; do not set locally unless testing.
#
# RAILWAY_ENVIRONMENT=              # "production" | "staging" — set by Railway
# RAILWAY_PUBLIC_DOMAIN=            # Auto-assigned public URL
# RAILWAY_PRIVATE_DOMAIN=           # Internal service mesh URL
# RAILWAY_SERVICE_NAME=             # Service identifier

# ──────────────────────────────────────────────────────────────────
# Vercel  (deployment platform)
# ──────────────────────────────────────────────────────────────────
# These are injected automatically by Vercel at deploy time.
# Listed here for documentation; do not set locally unless testing.
#
# VERCEL_ENV=                       # "production" | "preview" | "development"
# VERCEL_URL=                       # Auto-assigned deployment URL
# VERCEL_GIT_COMMIT_SHA=            # Git SHA for the deployment
